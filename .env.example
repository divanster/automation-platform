# Placeholders only. NEVER put real values in this file, and never commit a real .env.
#
# LOCAL SETUP (Windows PowerShell, from the repository root):
#     Copy-Item .env.example .env
#     notepad .env          # fill in AP_DB_NAME, AP_DB_USER, AP_DB_PASSWORD
# Then run `python manage.py ...` from backend\ as usual. No variables need to be set
# in the terminal. See docs/development/runbook.md, section 3.
#
# HOW IT IS READ. The application reads PROCESS ENVIRONMENT variables. For local
# development only, `manage.py` first fills in the ones that are not already set from
# the git-ignored `.env` in the repository root (backend/config/localenv.py):
#   * A variable already set in your terminal (even empty) wins over this file.
#   * Only `manage.py` with the development settings reads it. The production settings,
#     wsgi.py and asgi.py never do, so a deployment must supply real environment variables.
#   * Format: one NAME=value per line; only names starting with AP_; lines starting with
#     # are comments (there are NO inline comments, so a # inside a value is kept).
#     Wrap a value in single or double quotes to keep leading or trailing spaces.
#     Nothing is expanded ($VAR, %VAR% are plain text). Each name may appear once.
#   * A missing .env is fine (the terminal environment is used). An invalid .env stops
#     manage.py with the line number and the rule, never the value.
#   * If the database variables are missing, connecting fails. There is no SQLite fallback.

# --- PostgreSQL (the only application database; there is no SQLite fallback) ---
# Use a dedicated development database and role. Native PostgreSQL 18 on Windows.
AP_DB_NAME=
AP_DB_USER=
AP_DB_PASSWORD=
AP_DB_HOST=127.0.0.1
AP_DB_PORT=5432
# Seconds to wait for a connection before failing (default 3).
AP_DB_CONNECT_TIMEOUT=3

# --- Django ---
# Development: optional. If empty, a random per-process key is generated.
# Production: REQUIRED and must be supplied from outside the repository.
AP_SECRET_KEY=
# Development defaults to localhost only. Production: REQUIRED, explicit hosts,
# comma-separated, no wildcards. Example: app.example.invalid
AP_ALLOWED_HOSTS=
# Production only, optional: explicit https origins, comma-separated.
AP_CSRF_TRUSTED_ORIGINS=

# --- Tests ---
# Leave unset for normal runs. Set to 1 ONLY when running the PostgreSQL-backed
# tests against a dedicated development server (creates and drops test_<AP_DB_NAME>).
# Set it in the terminal for that one command (runbook section 5); do NOT put it in
# .env, or every `manage.py test` would start using the database.
# AP_RUN_DB_TESTS=1

# --- Persistent worker (python manage.py runworker) ---
# Provisional defaults, not measured. A handler must finish within the lease: this
# slice has no heartbeat. Allowed: lease 5 to 3600 seconds, poll 1 to 60 seconds.
# AP_WORKER_LEASE_SECONDS=60
# AP_WORKER_POLL_SECONDS=2
