# Placeholders only. NEVER put real values in this file.
#
# The application reads these from the PROCESS ENVIRONMENT. It does not read a
# .env file itself and has no dotenv dependency. To use a local, git-ignored
# .env file, load it into your PowerShell session first; see
# docs/development/runbook.md ("Environment configuration").

# --- PostgreSQL (the only application database; there is no SQLite fallback) ---
# Use a dedicated development database and role. Native PostgreSQL 18 on Windows.
AP_DB_NAME=
AP_DB_USER=
AP_DB_PASSWORD=
AP_DB_HOST=127.0.0.1
AP_DB_PORT=5432
# Seconds to wait for a connection before failing (default 3).
AP_DB_CONNECT_TIMEOUT=3

# --- Django ---
# Development: optional. If empty, a random per-process key is generated.
# Production: REQUIRED and must be supplied from outside the repository.
AP_SECRET_KEY=
# Development defaults to localhost only. Production: REQUIRED, explicit hosts,
# comma-separated, no wildcards. Example: app.example.invalid
AP_ALLOWED_HOSTS=
# Production only, optional: explicit https origins, comma-separated.
AP_CSRF_TRUSTED_ORIGINS=

# --- Tests ---
# Leave unset for normal runs. Set to 1 ONLY when running the PostgreSQL-backed
# tests against a dedicated development server (creates and drops test_<AP_DB_NAME>).
# AP_RUN_DB_TESTS=1
