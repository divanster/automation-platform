# Placeholders only. NEVER put real values in this file, and never commit a real .env.
#
# LOCAL SETUP (Windows PowerShell, from the repository root):
#     Copy-Item .env.example .env
#     notepad .env          # fill in AP_DB_NAME, AP_DB_USER, AP_DB_PASSWORD
# Then run `python manage.py ...` from backend\ as usual. No variables need to be set
# in the terminal. See docs/development/runbook.md, section 3.
#
# HOW IT IS READ. The application reads PROCESS ENVIRONMENT variables. For local
# development only, `manage.py` first fills in the ones that are not already set from
# the git-ignored `.env` in the repository root (backend/config/localenv.py):
#   * A variable already set in your terminal (even empty) wins over this file.
#   * Only `manage.py` with the development settings reads it. The production settings,
#     wsgi.py and asgi.py never do, so a deployment must supply real environment variables.
#   * Format: one NAME=value per line; only names starting with AP_; lines starting with
#     # are comments (there are NO inline comments, so a # inside a value is kept).
#     Wrap a value in single or double quotes to keep leading or trailing spaces.
#     Nothing is expanded ($VAR, %VAR% are plain text). Each name may appear once.
#   * A missing .env is fine (the terminal environment is used). An invalid .env stops
#     manage.py with the line number and the rule, never the value.
#   * If the database variables are missing, connecting fails. There is no SQLite fallback.

# --- PostgreSQL (the only application database; there is no SQLite fallback) ---
# Use a dedicated development database and role. Native PostgreSQL 18 on Windows.
AP_DB_NAME=
AP_DB_USER=
AP_DB_PASSWORD=
AP_DB_HOST=127.0.0.1
AP_DB_PORT=5432
# Seconds to wait for a connection before failing (default 3).
AP_DB_CONNECT_TIMEOUT=3

# --- Django ---
# Development: optional. If empty, a random per-process key is generated.
# Production: REQUIRED and must be supplied from outside the repository.
AP_SECRET_KEY=
# Development defaults to localhost only. Production: REQUIRED, explicit hosts,
# comma-separated, no wildcards. Example: app.example.invalid
AP_ALLOWED_HOSTS=
# Production only, optional: explicit https origins, comma-separated.
AP_CSRF_TRUSTED_ORIGINS=

# --- Tests ---
# Leave unset for normal runs. Set to 1 ONLY when running the PostgreSQL-backed
# tests against a dedicated development server (creates and drops test_<AP_DB_NAME>).
# Set it in the terminal for that one command (runbook section 5); do NOT put it in
# .env, or every `manage.py test` would start using the database.
# AP_RUN_DB_TESTS=1

# --- KPMG Workbench AI provider (AI-1b; opt-in, read only by config/ai_workbench.py) ---
# Nothing that runs today needs these. NEVER put a real key here: use your own git-ignored .env or the terminal.
# Only the key is required. Every other value defaults to the client-side contract reported from the FI integration audit
# (client-side evidence, not proof that the live service accepts it). See docs/development/runbook.md, section 5.5.
# AP_AI_WORKBENCH_API_KEY=
# Defaults shown; override only after live evidence. The endpoint host must stay api.workbench.kpmg (any other host is refused).
# AP_AI_WORKBENCH_AUTH_HEADER=Ocp-Apim-Subscription-Key
# AP_AI_WORKBENCH_CHAT_PATH=/deployments/{deployment}/chat/completions?api-version={api_version}
# AP_AI_WORKBENCH_ENDPOINT=https://api.workbench.kpmg/genai/azure/openai
# AP_AI_WORKBENCH_API_VERSION=2024-10-21
# AP_AI_WORKBENCH_CHARGE_CODE=00000000
# AP_AI_WORKBENCH_TIMEOUT_SECONDS=90
# AP_AI_WORKBENCH_MAX_RETRIES=2
# AP_AI_WORKBENCH_PROXY_URL=
# AP_AI_WORKBENCH_CA_BUNDLE=

# --- OpenAI-compatible AI provider (AI-CON-1; opt-in, read only by config/ai_openai_compatible.py; nothing in the application uses it yet) ---
# NO defaults: an installation that sets nothing has no such provider. NEVER put a real key here. Approving an endpoint takes TWO explicit values: the
# endpoint, and its origin in the allowlist. The locality is YOUR declaration (it is never guessed from the host name) and must match the host:
# `local` = localhost or a loopback address (plain http allowed here only); `company_endpoint` = https to a company host; `cloud` = https to a public host.
# See docs/development/runbook.md, section 5.8 and docs/architecture/ai-gateway.md, section 17.
# AP_AI_OPENAI_ENDPOINT=https://llm.example.invalid/v1
# AP_AI_OPENAI_ALLOWED_ORIGINS=https://llm.example.invalid
# AP_AI_OPENAI_LOCALITY=
# AP_AI_OPENAI_MODEL=
# REQUIRED when the locality is company_endpoint (refused otherwise), no default: the CIDR ranges the company endpoint may resolve to, comma-separated.
# Every resolved address must lie inside one; special-purpose and metadata ranges (loopback, 169.254.0.0/16, 100.64.0.0/10, 198.18.0.0/15, ...) cannot be approved.
# AP_AI_OPENAI_COMPANY_CIDRS=10.20.0.0/16
# Required unless the locality is local.
# AP_AI_OPENAI_API_KEY=
# Optional (defaults shown): whole-call deadline, retries, profile token limits.
# AP_AI_OPENAI_TIMEOUT_SECONDS=90
# AP_AI_OPENAI_MAX_RETRIES=2
# AP_AI_OPENAI_MAX_INPUT_TOKENS=32000
# AP_AI_OPENAI_MAX_OUTPUT_TOKENS=4096
# Explicit proxy only; HTTPS_PROXY / HTTP_PROXY / NO_PROXY are never read. Refused for a local endpoint AND for any host-name endpoint (a proxy would
# resolve the name where no address rule can be applied; there is no override), so it only works with an IP-literal endpoint.
# AP_AI_OPENAI_PROXY_URL=
# AP_AI_OPENAI_CA_BUNDLE=

# --- Native Ollama AI provider (AI-CON-2; opt-in, read only by config/ai_ollama.py; nothing in the application uses it yet) ---
# NO defaults: an installation that sets nothing has no such provider. Loopback ONLY (localhost or 127.x / ::1): any other host is refused, whatever is
# approved. There is no key, no locality setting and no proxy setting (a proxy value is refused). The application never installs or starts Ollama and never
# downloads a model: install Ollama and run `ollama pull <model>` yourself. See docs/development/runbook.md, section 5.9 and docs/architecture/ai-gateway.md, section 18.
# AP_AI_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# AP_AI_OLLAMA_ALLOWED_ORIGINS=http://127.0.0.1:11434
# AP_AI_OLLAMA_MODEL=
# Optional (defaults shown): json_mode or native_schema, whole-call deadline, retries, profile token limits.
# AP_AI_OLLAMA_STRUCTURED_OUTPUT=json_mode
# AP_AI_OLLAMA_TIMEOUT_SECONDS=90
# AP_AI_OLLAMA_MAX_RETRIES=2
# AP_AI_OLLAMA_MAX_INPUT_TOKENS=3072
# AP_AI_OLLAMA_MAX_OUTPUT_TOKENS=1024
# Optional, unset by default: the context window sent as num_ctx; the two limits above must fit inside it. Ollama silently truncates a prompt that does not fit.
# AP_AI_OLLAMA_NUM_CTX=
# --- Request Intake extraction mode (AI-2a; read only by the worker at start-up, config/intake_extraction.py) ---
# Unset or empty means `deterministic`: the fixture parser, no AI provider is ever called. `ai` must be asked for by name; there is NO
# automatic fallback between the two. In `ai` mode the worker refuses to start unless every value below (and AP_AI_WORKBENCH_API_KEY above) is valid.
# Sending request text to the Workbench is a decision for the owner: leave all of these unset unless you intend it. See runbook section 5.6.
# AP_INTAKE_EXTRACTION_MODE=
# REQUIRED in ai mode, no default: local_only | company_endpoint | approved_cloud. The Workbench is a company_endpoint provider, so local_only is refused.
# AP_AI_POLICY_MODE=
# Deadline of one AI call, 5 to 300 seconds (default 45). AP_WORKER_LEASE_SECONDS must be at least this plus 15.
# AP_INTAKE_AI_TIMEOUT_SECONDS=45

# --- Persistent worker (python manage.py runworker) ---
# Provisional defaults, not measured. A handler must finish within the lease: this
# slice has no heartbeat. Allowed: lease 5 to 3600 seconds, poll 1 to 60 seconds.
# AP_WORKER_LEASE_SECONDS=60
# AP_WORKER_POLL_SECONDS=2
